{
  "name": "echo-8-infinite-canvas",
  "version": "0.4.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "deploy:cloudflare": "pnpm run build && vinext-cloudflare deploy --skip-build --config dist/server/wrangler.json",
    "cloud:db:create": "wrangler d1 create echo8-control",
    "cloud:db:migrate": "wrangler d1 execute echo8-control --remote --file cloud/control/schema.sql",
    "generate:text-assist-data": "node scripts/generate-pycorrector-text-assist.mjs",
    "build:portable": "node scripts/generate-pycorrector-text-assist.mjs && node scripts/build-portable.mjs",
    "build:debug": "node scripts/generate-pycorrector-text-assist.mjs && vite build --config vite.debug.config.ts",
    "fixture:brutal": "node scripts/generate-brutal-fixture.mjs",
    "verify:brutal": "node --max-old-space-size=4096 --experimental-strip-types scripts/verify-brutal-fixture.mjs",
    "start": "vinext start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:performance-browser": "playwright test --config=playwright.performance.config.ts",
    "test:portable": "playwright test --config=playwright.portable.config.ts",
    "test:cross-browser": "playwright test --config=playwright.cross-browser.config.ts && playwright test --config=playwright.portable.cross-browser.config.ts",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm audit --prod && pnpm run test && pnpm run test:e2e && pnpm run test:performance-browser && pnpm run build && pnpm run build:portable && pnpm run test:portable",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json --experimental-warm-cdn-cache",
    "deploy:response-store": "wrangler deploy --config wrangler.response-store.jsonc"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.2.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@eslint/js": "^10.0.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vinext/cloudflare": "1.0.0-beta.10",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.0",
    "vinext": "1.0.0-beta.11",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
