# Public, non-secret deployment values
PUBLIC_APP_ORIGIN=https://canvas.example.com
ECHO8_CONTROL_DB_ID=replace-with-control-d1-uuid

# Cloudflare public OAuth application
CLOUDFLARE_OAUTH_CLIENT_ID=replace-with-oauth-client-id
CLOUDFLARE_OAUTH_CLIENT_SECRET=replace-with-oauth-client-secret
# Use the exact scope IDs shown by Cloudflare when creating the OAuth client.
# Required permissions: Memberships Read, Workers Scripts Write, D1 Write,
# Workers R2 Storage Write, plus OpenID profile/email scopes.
CLOUDFLARE_OAUTH_SCOPES=openid profile email offline_access

# Generate independently with: openssl rand -base64 48
SESSION_SECRET=replace-with-at-least-32-random-bytes
TOKEN_ENCRYPTION_KEY=replace-with-another-at-least-32-random-bytes

